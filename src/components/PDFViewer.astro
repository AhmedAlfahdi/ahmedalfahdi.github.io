---
interface Props {
  src: string;
  title?: string;
  height?: string;
  width?: string;
}

const {
  src,
  title = 'PDF Document',
  height = '640px',
} = Astro.props;
---

<div class="pdf-viewer-wrapper" data-pdf-wrapper style={`height: ${height};`}>
  <div class="pdf-header">
    <div class="pdf-meta">
      <span class="pdf-label">PDF</span>
      <span class="pdf-title" data-pdf-title>{title}</span>
    </div>
    <a href={src} class="pdf-btn" target="_blank" rel="noopener noreferrer">
      Open PDF
    </a>
  </div>

  <div class="pdf-frame">
    <iframe 
      class="pdf-iframe"
      data-pdf-iframe
      src={`${src}#toolbar=1&statusbar=0&navpanes=0&view=FitH`}
      title={title}
      loading="lazy"
      type="application/pdf"
      allow="fullscreen"
      onerror="this.closest('.pdf-viewer-wrapper').querySelector('[data-pdf-title]').textContent = 'PDF Preview Unavailable'; this.closest('.pdf-viewer-wrapper').querySelector('.pdf-error-message').style.display = 'block'; this.style.display = 'none';"
    ></iframe>
    <div class="pdf-error-message" style="display: none;">
      <p>Unable to display PDF preview. Please use the "Open PDF" button above to view the document.</p>
    </div>
  </div>

  <div class="pdf-mobile-fallback">
    <p>
      PDF preview may not be supported on this device. Use the button above to
      open the document in your browser or PDF viewer.
    </p>
  </div>

<script define:vars={{ src }}>
  document.addEventListener('DOMContentLoaded', function() {
    const wrappers = document.querySelectorAll('[data-pdf-wrapper]');
    
    // Detect Chrome mobile (Chrome mobile intercepts PDFs and shows download prompt)
    const isChromeMobile = /Android.*Chrome|CriOS/i.test(navigator.userAgent) && 
                           'ontouchstart' in window;
    
    wrappers.forEach(wrapper => {
      // Mark Chrome mobile wrappers
      if (isChromeMobile) {
        wrapper.setAttribute('data-chrome-mobile', 'true');
      }
      
      const iframe = wrapper.querySelector('[data-pdf-iframe]');
      const titleElement = wrapper.querySelector('[data-pdf-title]');
      const errorMessage = wrapper.querySelector('.pdf-error-message');
      
      if (!iframe || !titleElement || !errorMessage) return;
      
      const showErrorMessage = () => {
        if (titleElement.textContent !== 'PDF Preview Unavailable') {
          titleElement.textContent = 'PDF Preview Unavailable';
          titleElement.style.color = 'var(--text-muted)';
        }
        errorMessage.style.display = 'block';
        iframe.style.display = 'none';
      };
      
      // On Chrome mobile, hide iframe immediately (it will show download prompt anyway)
      if (isChromeMobile) {
        iframe.style.display = 'none';
      }
      
      // Check if PDF loads successfully
      iframe.addEventListener('load', () => {
        setTimeout(() => {
          try {
            const doc = iframe.contentDocument || iframe.contentWindow?.document;
            if (doc) {
              const bodyText = doc.body?.textContent || '';
              if (bodyText.includes('Failed to load PDF') || 
                  bodyText.includes('Unable to display PDF') ||
                  (bodyText.includes('PDF.js') && bodyText.includes('error'))) {
                showErrorMessage();
              }
            }
          } catch (e) {
            // Cross-origin - can't check, assume working
          }
        }, 2000);
      });
      
      // Handle iframe error event
      iframe.addEventListener('error', showErrorMessage);
    });
  });
</script>
</div>

<style>
  .pdf-viewer-wrapper {
    position: relative;
    display: flex;
    flex-direction: column;
    background: linear-gradient(135deg, rgba(26, 33, 42, 0.9), rgba(16, 24, 32, 0.95));
    border: 1px solid var(--border-strong);
    overflow: hidden;
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.04), 0 16px 32px rgba(0, 0, 0, 0.35);
    margin: 2rem auto;
    width: 80%;
    max-width: 1400px;
    align-self: center;  /* center in flex parents */
    justify-self: center; /* center in grid parents */
    place-self: center;   /* fallback centering for combined layouts */
  }

  .pdf-header {
    display: flex;
    align-items: center;
    justify-content: flex-start;
    padding: 0.9rem 1rem;
    background: rgba(12, 20, 28, 0.9);
    border-bottom: 1px solid var(--border-strong);
    gap: 0.75rem;
  }

  .pdf-meta {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    flex-wrap: wrap;
    color: var(--text-secondary);
  }

  .pdf-label {
    padding: 0.15rem 0.55rem;
    border: 1px solid var(--border-strong);
    background: rgba(245, 165, 36, 0.08);
    color: var(--accent-primary);
    font-weight: 700;
    letter-spacing: 1px;
    font-size: 0.75rem;
    white-space: nowrap; /* keep PDF together on narrow screens */
  }

  .pdf-title {
    font-weight: 600;
    color: var(--text-primary);
    letter-spacing: 0.5px;
  }

  .pdf-btn {
    background: var(--bg-tertiary);
    border: 1px solid var(--border-strong);
    padding: 0.45rem 0.7rem;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    transition: all 0.2s;
    color: var(--text-primary);
    font-size: 0.875rem;
    font-weight: 500;
    text-decoration: none;
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.04);
  }

  .pdf-btn:hover {
    background: rgba(245, 165, 36, 0.08);
    border-color: var(--accent-primary);
    color: var(--accent-primary);
  }

  .pdf-frame {
    flex: 1;
    background: #0d131b;
    border-top: 1px solid var(--border-strong);
    position: relative;
    width: 100%;
  }

  .pdf-iframe {
    width: 100%;
    height: 100%;
    border: none;
    background: #0d131b;
    /* Safari-specific fixes */
    -webkit-overflow-scrolling: touch;
  }

  /* Safari desktop: ensure PDF renders properly */
  @supports (-webkit-appearance: none) {
    .pdf-iframe {
      display: block;
    }
  }

  .pdf-mobile-fallback {
    display: none;
    padding: 0.75rem 1rem 1rem;
    font-size: 0.85rem;
    color: var(--text-secondary);
  }

  .pdf-error-message {
    padding: 2rem;
    text-align: center;
    color: var(--text-secondary);
    background: rgba(245, 165, 36, 0.05);
    border: 1px solid rgba(245, 165, 36, 0.2);
    border-radius: 4px;
    margin: 1rem;
  }

  .pdf-error-message p {
    margin: 0;
    font-size: 0.9rem;
    line-height: 1.5;
  }

  @media (max-width: 640px) {
    .pdf-viewer-wrapper {
      margin: 1.5rem 0;
      width: 100%;
      align-self: stretch;
      height: auto !important;
    }
    .pdf-header {
      flex-wrap: wrap;
      gap: 0.5rem 0.75rem;
      justify-content: space-between;
    }
    .pdf-btn {
      flex: 1;
      min-width: 120px;
      text-align: center;
    }
    .pdf-iframe {
      min-height: 420px;
    }
  }

  /* Safari iOS specific: hide iframe, show fallback */
  @supports (-webkit-touch-callout: none) {
    @media (max-width: 640px) {
      .pdf-frame {
        display: none !important;
      }
      .pdf-mobile-fallback {
        display: block !important;
      }
    }
  }

  /* Chrome mobile: hide iframe (Chrome mobile intercepts PDFs and shows download prompt) */
  .pdf-viewer-wrapper[data-chrome-mobile] .pdf-frame {
    display: none !important;
  }
  .pdf-viewer-wrapper[data-chrome-mobile] .pdf-mobile-fallback {
    display: block !important;
  }
</style>
