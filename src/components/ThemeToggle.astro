---
// ThemeToggle component for switching between light and dark themes
---

<button id="theme-toggle" class="theme-toggle" aria-label="Toggle theme" title="Toggle theme">
  <span class="theme-icon sun-icon">☀</span>
  <span class="theme-icon moon-icon">☾</span>
</button>

<script>
  if (typeof window !== 'undefined') {
    const themeToggle = document.getElementById('theme-toggle');
    const root = document.documentElement;
    
    // Get theme - prioritize user preference, then system preference
    const getTheme = () => {
      const stored = localStorage.getItem('theme');
      if (stored) return stored;
      
      // Check system preference
      if (window.matchMedia && window.matchMedia('(prefers-color-scheme: light)').matches) {
        return 'light';
      }
      
      return 'dark';
    };
    
    // Set theme
    const setTheme = (theme, saveToStorage = false) => {
      if (theme === 'light') {
        root.setAttribute('data-theme', 'light');
        themeToggle?.classList.add('light-mode');
      } else {
        root.removeAttribute('data-theme');
        themeToggle?.classList.remove('light-mode');
      }
      
      // Only save to localStorage if explicitly requested (manual toggle)
      if (saveToStorage) {
        localStorage.setItem('theme', theme);
      }
    };
    
    // Initialize theme (don't save to localStorage on initial load)
    const currentTheme = getTheme();
    setTheme(currentTheme, false);
    
    // Toggle theme on click - save user's manual choice
    themeToggle?.addEventListener('click', () => {
      const currentTheme = root.getAttribute('data-theme');
      const newTheme = currentTheme === 'light' ? 'dark' : 'light';
      setTheme(newTheme, true);
    });
    
    // Listen for system theme changes
    if (window.matchMedia) {
      window.matchMedia('(prefers-color-scheme: light)').addEventListener('change', (e) => {
        const stored = localStorage.getItem('theme');
        // Only auto-switch if user hasn't manually set a preference
        if (!stored) {
          setTheme(e.matches ? 'light' : 'dark', false);
        }
      });
    }
  }
</script>

<style>
  .theme-toggle {
    position: absolute;
    top: 50%;
    left: 1rem;
    transform: translateY(-50%);
    width: 48px;
    height: 48px;
    background: rgba(12, 20, 28, 0.9);
    border: 1px solid var(--border-strong);
    border-radius: 50%;
    cursor: pointer;
    transition: all 0.3s ease;
    z-index: 10;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.04),
      0 4px 12px rgba(0, 0, 0, 0.25);
  }

  .theme-toggle:hover {
    border-color: var(--accent-primary);
    background: rgba(245, 165, 36, 0.1);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.04),
      0 4px 12px rgba(0, 0, 0, 0.25),
      0 0 20px rgba(245, 165, 36, 0.3);
  }

  .theme-toggle:active {
    transform: scale(0.98);
  }

  .theme-icon {
    position: absolute;
    font-size: 1.5rem;
    transition: all 0.3s ease;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  /* Default (dark mode) - show sun icon */
  .sun-icon {
    opacity: 1;
    transform: rotate(0deg) scale(1);
    color: var(--accent-primary);
  }

  .moon-icon {
    opacity: 0;
    transform: rotate(180deg) scale(0);
    color: var(--accent-secondary);
  }

  /* Light mode - show moon icon */
  .theme-toggle.light-mode .sun-icon {
    opacity: 0;
    transform: rotate(-180deg) scale(0);
  }

  .theme-toggle.light-mode .moon-icon {
    opacity: 1;
    transform: rotate(0deg) scale(1);
  }

  /* Light theme styling */
  :root[data-theme="light"] .theme-toggle {
    background: rgba(255, 255, 255, 0.9);
    box-shadow:
      inset 0 1px 0 rgba(0, 0, 0, 0.02),
      0 4px 12px rgba(0, 0, 0, 0.08);
  }

  :root[data-theme="light"] .theme-toggle:hover {
    border-color: var(--accent-primary);
    background: rgba(214, 137, 16, 0.08);
    box-shadow:
      inset 0 1px 0 rgba(0, 0, 0, 0.02),
      0 4px 12px rgba(0, 0, 0, 0.08),
      0 0 20px rgba(214, 137, 16, 0.25);
  }

  @media (max-width: 768px) {
    .theme-toggle {
      left: 0.5rem;
      width: 40px;
      height: 40px;
    }

    .theme-icon {
      font-size: 1.2rem;
    }
  }

  @media (max-width: 480px) {
    .theme-toggle {
      width: 36px;
      height: 36px;
      left: 0.5rem;
    }

    .theme-icon {
      font-size: 1.1rem;
    }
  }
</style>
