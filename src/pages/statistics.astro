              datasets: [{
                label: 'Visits',
                data: data.operatingSystems.map(o => o.count),
                backgroundColor: barColors.success,
                borderColor: colors.success.replace('0.8', '1'),
                borderWidth: 2,
                borderRadius: 4
              }]
            },
            options: {
              ...chartConfig,
              indexAxis: 'y',
              plugins: {
                ...chartConfig.plugins,
                legend: { display: false }
              }
            }
          });
        }
        
        // Visits by Hour Chart
        const ctxHour = document.getElementById('visits-by-hour-chart');
        if (ctxHour && data.visitsByHour && data.visitsByHour.length > 0) {
          const sortedHours = data.visitsByHour.sort((a, b) => parseInt(a.name) - parseInt(b.name));
          new Chart(ctxHour, {
            type: 'line',
            data: {
              labels: sortedHours.map(h => `${h.name}:00`),
              datasets: [{
                label: 'Visits',
                data: sortedHours.map(h => h.count),
                borderColor: colors.primary,
                backgroundColor: colors.primary.replace('0.8', '0.1'),
                borderWidth: 3,
                fill: true,
                tension: 0.4,
                pointRadius: 4,
                pointHoverRadius: 6
              }]
            },
            options: {
              ...chartConfig,
              plugins: {
                ...chartConfig.plugins,
                legend: { display: false }
              }
            }
          });
        }
        
        // Visits by Day Chart
        const ctxDay = document.getElementById('visits-by-day-chart');
        if (ctxDay && data.visitsByDay && data.visitsByDay.length > 0) {
          const dayOrder = ['Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'];
          const sortedDays = data.visitsByDay.sort((a, b) => 
            dayOrder.indexOf(a.name) - dayOrder.indexOf(b.name)
          );
          new Chart(ctxDay, {
            type: 'bar',
            data: {
              labels: sortedDays.map(d => d.name.substring(0, 3)),
              datasets: [{
                label: 'Visits',
                data: sortedDays.map(d => d.count),
                backgroundColor: barColors.purple,
                borderColor: colors.purple.replace('0.8', '1'),
                borderWidth: 2,
                borderRadius: 4
              }]
            },
            options: {
              ...chartConfig,
              plugins: {
                ...chartConfig.plugins,
                legend: { display: false }
              }
            }
          });
        }
        
        // Countries Chart (NEW)
        const ctxCountries = document.getElementById('countries-chart');
        if (ctxCountries && data.countries && data.countries.length > 0) {
          const topCountries = data.countries.slice(0, 15);
          new Chart(ctxCountries, {
            type: 'bar',
            data: {
              labels: topCountries.map(c => c.name),
              datasets: [{
                label: 'Page Views',
                data: topCountries.map(c => c.count),
                backgroundColor: topCountries.map((_, i) => {
                  const alpha = 0.9 - (i * 0.04);
                  return `rgba(245, 165, 36, ${alpha})`;
                }),
                borderColor: colors.primary.replace('0.8', '1'),
                borderWidth: 1,
                borderRadius: 3
              }]
            },
            options: {
              ...chartConfig,
              indexAxis: 'y',
              plugins: {
                ...chartConfig.plugins,
                legend: { display: false },
                tooltip: {
                  ...chartConfig.plugins.tooltip,
                  callbacks: {
                    label: function(context) {
                      const val = context.raw;
                      const total = context.dataset.data.reduce((a, b) => a + b, 0);
                      const pct = total > 0 ? ((val / total) * 100).toFixed(1) : 0;
                      return `${val} views (${pct}%)`;
                    }
                  }
                }
              }
            }
          });
        }

        // World map: store data globally for when MapLibre is ready and render
        window.__statsDataForMap = data;
        if (mapLibreLoaded && window.maplibregl) {
          renderWorldMap(data, 50);
        }

        // Wire up map toggle buttons (Latest 50 / This Week / All)
        const totalLocations = (data.allVisitorLocations && data.allVisitorLocations.length)
          || (data.recentVisitors && data.recentVisitors.length)
          || 0;

        // Count visitors from last 7 days
        const weekAgo = Date.now() - 7 * 24 * 60 * 60 * 1000;
        const weekCount = (data.allVisitorLocations || data.recentVisitors || [])
          .filter(v => { try { return v.timestamp && new Date(v.timestamp).getTime() >= weekAgo; } catch { return false; } })
          .length;

        const toggleGroup = document.getElementById('map-toggle-group');
        const btnRecent = document.getElementById('map-btn-recent');
        const btnWeek = document.getElementById('map-btn-week');
        const btnAll = document.getElementById('map-btn-all');
        const btnAllCount = document.getElementById('map-btn-all-count');

        const setActiveBtn = (activeBtn) => {
          [btnRecent, btnWeek, btnAll].forEach(b => b && b.classList.remove('active'));
          if (activeBtn) activeBtn.classList.add('active');
        };

        if (toggleGroup && totalLocations > 50) {
          toggleGroup.style.display = 'inline-flex';
          if (btnAllCount) btnAllCount.textContent = totalLocations;
          // Show week count if any
          if (btnWeek && weekCount > 0) {
            btnWeek.textContent = `This Week (${weekCount})`;
          }

          btnRecent.addEventListener('click', () => {
            if (btnRecent.classList.contains('active')) return;
            setActiveBtn(btnRecent);
            renderWorldMap(data, 50);
          });

          btnWeek.addEventListener('click', () => {
            if (btnWeek.classList.contains('active')) return;
            setActiveBtn(btnWeek);
            renderWorldMap(data, 'week');
          });

          btnAll.addEventListener('click', () => {
            if (btnAll.classList.contains('active')) return;
            setActiveBtn(btnAll);
            renderWorldMap(data, 0);
          });
        } else if (toggleGroup && totalLocations <= 50 && totalLocations > 0) {
          toggleGroup.style.display = 'inline-flex';
          btnRecent.textContent = `All ${totalLocations}`;
          btnRecent.classList.add('active');
          if (btnWeek) btnWeek.style.display = 'none';
          btnAll.style.display = 'none';
        }
        
      } catch (error) {
        // Clear timeouts
        if (apiTimeout) {
          clearTimeout(apiTimeout);
          apiTimeout = null;
        }
        
        // Mark request as complete
        requestInProgress = false;
        
        // Don't show error if timeout already fired
        if (timeoutFired) {
          console.error('Failed to load statistics (timeout already handled):', error);
          return;
        }
        
        // Try to retry if we haven't exceeded max retries
        if (retryCount < MAX_RETRIES) {
          retryCount++;
          const errorMsg = error.name === 'AbortError' || error.message?.includes('timeout') 
            ? 'Request timed out' 
            : error.message || 'Network error';
          loadingEl.innerHTML = `${errorMsg}. Retrying... (${retryCount}/${MAX_RETRIES})`;
          setTimeout(() => {
            requestInProgress = true;
            timeoutFired = false;
            loadStats(true);
          }, RETRY_DELAY);
          console.warn(`Statistics load failed, retrying (${retryCount}/${MAX_RETRIES}):`, error);
          return;
        }
        
        // Max retries reached, show error
        loadingEl.style.display = 'none';
        errorEl.style.display = 'block';
        contentEl.style.display = 'none';
        
        let errorMessage = 'Unable to load statistics after multiple attempts. ';
        if (error.name === 'AbortError' || error.message?.includes('timeout')) {
          errorMessage += 'Request timed out. The analytics API may be slow or unavailable.';
        } else if (error.message) {
          errorMessage += error.message;
        } else if (error.name === 'TypeError' && error.message?.includes('fetch')) {
          errorMessage += 'Network error. Please check your connection.';
        } else {
          errorMessage += 'Please try refreshing the page.';
        }
        
        errorEl.innerHTML = `<p>${errorMessage}</p><p style="margin-top: 0.5rem; font-size: 0.9rem; opacity: 0.8;">You can try refreshing the page or check the browser console for more details.</p><button id="retry-stats-btn" style="margin-top: 1rem; padding: 0.5rem 1rem; background: var(--accent-primary); color: var(--bg-primary); border: none; border-radius: 4px; cursor: pointer; font-weight: 600;">Retry Now</button>`;
        console.error('Failed to load statistics after retries:', error);
        
        // Add retry button handler
        const retryBtn = document.getElementById('retry-stats-btn');
        if (retryBtn) {
          retryBtn.onclick = () => {
            retryCount = 0;
            requestInProgress = true;
            timeoutFired = false;
            errorEl.style.display = 'none';
            loadingEl.style.display = 'block';
            loadingEl.innerHTML = 'Loading statistics...';
            loadStats();
          };
        }
      }
    };
  }
</script>

