    document.head.appendChild(script);
    
    let retryCount = 0;
    const MAX_RETRIES = 3;
    const RETRY_DELAY = 3000; // 3 seconds between retries
    
    // Helper to format the "recent visitors" line so we don't spam "unknown" values
    const formatVisitorDetails = (visitor) => {
      if (!visitor) return '';

      const parts = [];

      // Always show path if we have it
      if (visitor.path) {
        parts.push(visitor.path);
      }

      const meta = [];

      // Location (city / region / country) if available
      const locationBits = [];
      if (visitor.city) locationBits.push(visitor.city);
      if (visitor.regionCode) locationBits.push(visitor.regionCode);
      if (visitor.countryCode) locationBits.push(visitor.countryCode);
      const location = locationBits.join(', ');
      if (location) {
        meta.push(location);
      }

      // Only include fields that actually exist
      if (visitor.deviceType) meta.push(visitor.deviceType);
      if (visitor.browser) meta.push(visitor.browser);
      if (visitor.os) meta.push(visitor.os);
      if (visitor.source || visitor.sourceType) {
        meta.push(visitor.source || visitor.sourceType);
      }

      if (meta.length > 0) {
        parts.push(meta.join(' • '));
      }

      // Time is always useful context
      if (visitor.timestamp) {
        try {
          parts.push(new Date(visitor.timestamp).toLocaleString());
        } catch {
          // If timestamp is malformed, just skip it
        }
      }

      // Fallback if we somehow have nothing
      if (parts.length === 0) {
        return 'Unknown visitor';
      }

      return parts.join(' • ');
    };

    const loadStats = async (isRetry = false) => {
      const loadingEl = document.getElementById('stats-loading');
      const errorEl = document.getElementById('stats-error');
      const contentEl = document.getElementById('stats-content');
      
      // Show retry message if this is a retry attempt
      if (isRetry && retryCount > 0) {
        loadingEl.innerHTML = `Loading statistics... (Retry ${retryCount}/${MAX_RETRIES})`;
      }
      
      // Set a timeout for the API call (fallback in case AbortController doesn't work)
      let apiTimeout;
      let timeoutFired = false;
      let requestInProgress = true;
      
      const showTimeoutError = () => {
        if (!requestInProgress || timeoutFired) return; // Prevent duplicate error messages
        timeoutFired = true;
        requestInProgress = false;
        
        // Try to retry if we haven't exceeded max retries
        if (retryCount < MAX_RETRIES) {
          retryCount++;
          loadingEl.innerHTML = `Request timed out. Retrying... (${retryCount}/${MAX_RETRIES})`;
          setTimeout(() => {
            requestInProgress = true;
            timeoutFired = false;
            loadStats(true);
          }, RETRY_DELAY);
          return;
        }
        
        // Max retries reached, show error
        loadingEl.style.display = 'none';
        errorEl.style.display = 'block';
        errorEl.innerHTML = '<p>Request timed out after multiple attempts. The analytics API may be unavailable.</p><p style="margin-top: 0.5rem; font-size: 0.9rem; opacity: 0.8;">Please try refreshing the page or check back later.</p><button id="retry-stats-btn" style="margin-top: 1rem; padding: 0.5rem 1rem; background: var(--accent-primary); color: var(--bg-primary); border: none; border-radius: 4px; cursor: pointer; font-weight: 600;">Retry Now</button>';
        contentEl.style.display = 'none';
        
        // Add retry button handler
        const retryBtn = document.getElementById('retry-stats-btn');
        if (retryBtn) {
          retryBtn.onclick = () => {
            retryCount = 0;
            requestInProgress = true;
            timeoutFired = false;
            errorEl.style.display = 'none';
            loadingEl.style.display = 'block';
            loadingEl.innerHTML = 'Loading statistics...';
            loadStats();
          };
        }
      };
      
      apiTimeout = setTimeout(showTimeoutError, 12000); // 12 second fallback timeout (longer than Promise.race timeout)
      
      try {
        // Create a more robust timeout mechanism using Promise.race
        const timeoutPromise = new Promise((_, reject) => {
          setTimeout(() => {
            reject(new Error('Request timeout: API took too long to respond'));
          }, 8000); // 8 second timeout (shorter than fallback)
        });
        
        // Create fetch promise with AbortController as backup
        const controller = new AbortController();
        const abortTimeout = setTimeout(() => {
          controller.abort();
        }, 8000);
        
        const fetchPromise = fetch(API_ENDPOINT, {
          signal: controller.signal,
          method: 'GET',
          headers: {
            'Accept': 'application/json',
          },
          cache: 'no-cache', // Prevent caching issues
          mode: 'cors',
        }).then(async (response) => {
          clearTimeout(abortTimeout);
          
          if (!response.ok) {
            throw new Error(`API returned ${response.status}: ${response.statusText}`);
          }
          
          // Add timeout for JSON parsing as well
          const jsonTimeout = new Promise((_, reject) => {
            setTimeout(() => reject(new Error('JSON parsing timeout')), 3000);
          });
          
          const jsonPromise = response.json();
          const data = await Promise.race([jsonPromise, jsonTimeout]);
          
          return data;
        });
        
        // Race between fetch and timeout
        const data = await Promise.race([fetchPromise, timeoutPromise]);
        
        // Clear all timeouts on success
        clearTimeout(abortTimeout);
        if (apiTimeout) {
          clearTimeout(apiTimeout);
          apiTimeout = null;
        }
        
        // Mark request as complete
        requestInProgress = false;
        timeoutFired = false;
        
        // Success! Reset retry count and show content
        retryCount = 0;
        loadingEl.style.display = 'none';
        loadingEl.innerHTML = 'Loading statistics...'; // Reset loading message
        errorEl.style.display = 'none';
        contentEl.style.display = 'block';
        
        // Animate numbers with counter effect
        const animateValue = (element, start, end, duration, suffix = '') => {
          const startTime = performance.now();
          const isNumber = typeof end === 'number';
          
          const animate = (currentTime) => {
            const elapsed = currentTime - startTime;
            const progress = Math.min(elapsed / duration, 1);
            
            // Easing function (ease-out)
            const easeOut = 1 - Math.pow(1 - progress, 3);
            
            if (isNumber) {
              const current = Math.floor(start + (end - start) * easeOut);
              element.textContent = current + suffix;
              element.setAttribute('data-value', current);
            } else {
              // For strings like "159s" or "53%"
              element.textContent = end;
              element.setAttribute('data-value', end);
            }
            
            if (progress < 1) {
              requestAnimationFrame(animate);
            } else {
              element.classList.remove('animating');
            }
          };
          
          element.classList.add('animating');
          requestAnimationFrame(animate);
        };
        
        // Update overview stats with animation
        const totalViews = data.totalViews || 0;
        const distinctIPs = data.distinctIPs || 0;
        const uniqueVisitors = data.uniqueVisitors || 0;
        const totalSessions = data.totalSessions || 0;
        const newVisitors = data.newVisitors || 0;
        const returningVisitors = data.returningVisitors || 0;
        const avgTime = data.avgTimeOnPage ? `${data.avgTimeOnPage}s` : '0s';
        const avgScroll = data.avgScrollDepth ? `${data.avgScrollDepth}%` : '0%';
        const bounceRate = data.bounceRate !== undefined ? `${data.bounceRate}%` : '0%';
        
        // Animate each stat with a slight delay for visual effect
        setTimeout(() => animateValue(document.getElementById('total-views'), 0, totalViews, 1000), 0);
        setTimeout(() => animateValue(document.getElementById('distinct-ips'), 0, distinctIPs, 1000), 100);
        setTimeout(() => animateValue(document.getElementById('unique-visitors'), 0, uniqueVisitors, 1000), 200);
        setTimeout(() => animateValue(document.getElementById('total-sessions'), 0, totalSessions, 1000), 300);
        setTimeout(() => animateValue(document.getElementById('new-visitors'), 0, newVisitors, 1000), 400);
