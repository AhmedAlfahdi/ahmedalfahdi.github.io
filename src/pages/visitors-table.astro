---
import BaseLayout from '../layouts/BaseLayout.astro';
import { createHash } from 'crypto';

const password = import.meta.env.PUBLIC_VISITORS_TABLE_PASSWORD || 'visitors';
const expectedHash = createHash('sha256').update(password).digest('hex');
---

<BaseLayout title="Visitor Data Table - Website Statistics">
  <div class="container" data-expected-hash={expectedHash}>
    <div id="password-gate" class="password-gate">
      <div class="password-gate-card">
        <h2>Password Required</h2>
        <p class="password-gate-desc">This page is protected. Enter the password to view visitor data.</p>
        <form id="password-form" class="password-form">
          <input type="password" id="password-input" placeholder="Enter password" autocomplete="current-password" />
          <button type="submit" class="btn-primary">Unlock</button>
        </form>
        <p id="password-error" class="password-error" style="display: none;">Incorrect password. Please try again.</p>
      </div>
    </div>

    <div id="table-area" style="display: none;">
    <h1>Visitor Data Table</h1>
    <p style="color: var(--text-secondary); margin-bottom: 2rem;">
      Detailed view of all visitors with filtering capabilities.
    </p>
    
    <div id="table-loading" class="loading-message">
      Loading visitor data...
    </div>
    
    <div id="table-error" class="error-message" style="display: none;">
      <p>Unable to load visitor data. Please ensure the analytics API is configured.</p>
    </div>
    
    <div id="table-content" style="display: none;">
      <!-- Filters Section -->
      <div class="filters-section">
        <h2>Filters</h2>
        <div class="filters-grid">
          <div class="filter-group">
            <label for="filter-ip">IP Address</label>
            <input type="text" id="filter-ip" placeholder="Filter by IP..." />
          </div>
          <div class="filter-group">
            <label for="filter-path">Path</label>
            <input type="text" id="filter-path" placeholder="Filter by path..." />
          </div>
          <div class="filter-group">
            <label for="filter-city">City</label>
            <input type="text" id="filter-city" placeholder="Filter by city..." />
          </div>
          <div class="filter-group">
            <label for="filter-country">Country</label>
            <input type="text" id="filter-country" placeholder="Filter by country..." />
          </div>
          <div class="filter-group">
            <label for="filter-device">Device Type</label>
            <select id="filter-device">
              <option value="">All Devices</option>
            </select>
          </div>
          <div class="filter-group">
            <label for="filter-browser">Browser</label>
            <select id="filter-browser">
              <option value="">All Browsers</option>
            </select>
          </div>
          <div class="filter-group">
            <label for="filter-os">Operating System</label>
            <select id="filter-os">
              <option value="">All OS</option>
            </select>
          </div>
          <div class="filter-group">
            <label for="filter-source">Source</label>
            <input type="text" id="filter-source" placeholder="Filter by source..." />
          </div>
          <div class="filter-group">
            <label for="filter-date-from">Date From</label>
            <input type="date" id="filter-date-from" />
          </div>
          <div class="filter-group">
            <label for="filter-date-to">Date To</label>
            <input type="date" id="filter-date-to" />
          </div>
          <div class="filter-group filter-group-toggle">
            <label for="filter-unique-only">View mode</label>
            <label class="toggle-label">
              <input type="checkbox" id="filter-unique-only" checked />
              <span>Unique visitors only</span>
            </label>
            <small class="filter-hint">One row per IP; shows most recent visit and visit count</small>
          </div>
        </div>
        <div class="filter-actions">
          <button id="clear-filters" class="btn-secondary">Clear All Filters</button>
          <span id="filter-count" class="filter-count">Showing <span id="filter-count-value">0</span> of <span id="filter-total-value">0</span> <span id="filter-count-label">visitors</span></span>
        </div>
      </div>
      
      <!-- Table Section -->
      <div class="table-section">
        <div class="table-wrapper">
          <table id="visitors-table" class="visitors-table">
            <thead>
              <tr>
                <th data-sort="visits" class="visits-col" style="display: none;">Visits <span class="sort-indicator"></span></th>
                <th data-sort="timestamp">Timestamp <span class="sort-indicator"></span></th>
                <th data-sort="ip">IP Address <span class="sort-indicator"></span></th>
                <th data-sort="path">Path <span class="sort-indicator"></span></th>
                <th data-sort="city">City <span class="sort-indicator"></span></th>
                <th data-sort="regionCode">Region <span class="sort-indicator"></span></th>
                <th data-sort="countryCode">Country <span class="sort-indicator"></span></th>
                <th data-sort="deviceType">Device <span class="sort-indicator"></span></th>
                <th data-sort="browser">Browser <span class="sort-indicator"></span></th>
                <th data-sort="os">OS <span class="sort-indicator"></span></th>
                <th data-sort="source">Source <span class="sort-indicator"></span></th>
              </tr>
            </thead>
            <tbody id="visitors-tbody">
              <!-- Table rows will be inserted here -->
            </tbody>
          </table>
        </div>
      </div>
    </div>
    </div>
  </div>
</BaseLayout>

<style>
  .password-gate {
    min-height: 40vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 2rem;
  }
  .password-gate-card {
    background: var(--bg-tertiary);
    border: 1px solid var(--border-strong);
    border-radius: 8px;
    padding: 2rem;
    max-width: 360px;
    width: 100%;
  }
  .password-gate-card h2 {
    margin: 0 0 0.5rem 0;
    color: var(--text-primary);
    font-size: 1.25rem;
  }
  .password-gate-desc {
    color: var(--text-secondary);
    font-size: 0.9rem;
    margin: 0 0 1.5rem 0;
  }
  .password-form {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  .password-form input {
    padding: 0.6rem 0.75rem;
    border: 1px solid var(--border-strong);
    border-radius: 6px;
    background: var(--bg-primary);
    color: var(--text-primary);
    font-size: 1rem;
  }
  .password-form input:focus {
    outline: none;
    border-color: var(--accent-primary);
  }
  .password-form .btn-primary {
    padding: 0.6rem 1rem;
    background: var(--accent-primary);
    color: var(--bg-primary);
    border: none;
    border-radius: 6px;
    font-weight: 600;
    cursor: pointer;
  }
  .password-form .btn-primary:hover {
    filter: brightness(1.1);
  }
  .password-error {
    margin: 1rem 0 0 0;
    color: #e1695d;
    font-size: 0.9rem;
  }

  .loading-message,
  .error-message {
    padding: 1.5rem;
    background: var(--bg-tertiary);
    border: 1px solid var(--border-strong);
    border-left: 4px solid var(--accent-secondary);
    margin: 1rem 0;
    color: var(--text-secondary);
  }
  
  .error-message {
    border-left-color: #e1695d;
  }
  
  .filters-section {
    background: var(--bg-tertiary);
    border: 1px solid var(--border-strong);
    border-radius: 8px;
    padding: 1.5rem;
    margin: 2rem 0;
  }
  
  .filters-section h2 {
    color: var(--text-primary);
    font-size: 1.25rem;
    font-weight: 600;
    margin: 0 0 1.5rem 0;
    padding-bottom: 0.75rem;
    border-bottom: 2px solid var(--border-strong);
  }
  
  .filters-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 1rem;
    margin-bottom: 1.5rem;
  }
  
  .filter-group {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  
  .filter-group label {
    color: var(--text-secondary);
    font-size: 0.85rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }
  
  .filter-group input,
  .filter-group select {
    padding: 0.5rem 0.75rem;
    background: var(--bg-primary);
    border: 1px solid var(--border-strong);
    border-radius: 4px;
    color: var(--text-primary);
    font-family: var(--font-mono);
    font-size: 0.9rem;
    transition: all 0.2s ease;
  }
  
  .filter-group input:focus,
  .filter-group select:focus {
    outline: none;
    border-color: var(--accent-primary);
    box-shadow: 0 0 0 3px rgba(245, 165, 36, 0.1);
  }

  .filter-group-toggle .toggle-label {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    cursor: pointer;
    text-transform: none;
    font-weight: 500;
  }
  .filter-group-toggle .toggle-label input[type="checkbox"] {
    width: 1.1rem;
    height: 1.1rem;
    accent-color: var(--accent-primary);
  }
  .filter-hint {
    color: var(--text-muted);
    font-size: 0.75rem;
    margin-top: 0.25rem;
  }
  
  .filter-actions {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem;
    padding-top: 1rem;
    border-top: 1px solid var(--border-strong);
  }
  
  .btn-secondary {
    padding: 0.5rem 1rem;
    background: var(--bg-primary);
    border: 1px solid var(--border-strong);
    border-radius: 4px;
    color: var(--text-primary);
    font-size: 0.9rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s ease;
  }
  
  .btn-secondary:hover {
    background: var(--bg-secondary);
    border-color: var(--accent-primary);
    color: var(--accent-primary);
  }
  
  .filter-count {
    color: var(--text-secondary);
    font-size: 0.9rem;
    font-family: var(--font-mono);
  }
  
  .filter-count strong {
    color: var(--accent-primary);
  }
  
  .table-section {
    margin: 2rem 0;
  }
  
  .table-wrapper {
    background: var(--bg-tertiary);
    border: 1px solid var(--border-strong);
    border-radius: 8px;
    overflow-x: auto;
    overflow-y: visible;
  }
  
  .visitors-table {
    width: 100%;
    border-collapse: collapse;
    font-family: var(--font-mono);
    font-size: 0.85rem;
  }
  
  .visitors-table thead {
    background: var(--bg-secondary);
    position: sticky;
    top: 0;
    z-index: 10;
  }
  
  .visitors-table th {
    padding: 1rem 0.75rem;
    text-align: left;
    color: var(--text-primary);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    font-size: 0.8rem;
    border-bottom: 2px solid var(--border-strong);
    cursor: pointer;
    user-select: none;
    white-space: nowrap;
    position: relative;
  }
  
  .visitors-table th:hover {
    background: var(--bg-tertiary);
    color: var(--accent-primary);
  }
  
  .visitors-table th[data-sort] {
    padding-right: 1.5rem;
  }
  
  .sort-indicator {
    position: absolute;
    right: 0.5rem;
    top: 50%;
    transform: translateY(-50%);
    opacity: 0.3;
    font-size: 0.7rem;
  }
  
  .visitors-table th[data-sort-direction="asc"] .sort-indicator::after {
    content: '▲';
    opacity: 1;
    color: var(--accent-primary);
  }
  
  .visitors-table th[data-sort-direction="desc"] .sort-indicator::after {
    content: '▼';
    opacity: 1;
    color: var(--accent-primary);
  }
  
  .visitors-table tbody tr {
    border-bottom: 1px solid var(--border-light);
    transition: background 0.2s ease;
  }
  
  .visitors-table tbody tr:hover {
    background: rgba(245, 165, 36, 0.05);
  }
  
  .visitors-table tbody tr:last-child {
    border-bottom: none;
  }
  
  .visitors-table td {
    padding: 0.75rem;
    color: var(--text-primary);
    vertical-align: top;
  }
  
  .visitors-table td:first-child {
    white-space: nowrap;
  }
  
  .visitors-table .empty-cell {
    color: var(--text-muted);
    font-style: italic;
  }
  
  .visitors-table .badge {
    display: inline-block;
    padding: 0.25rem 0.5rem;
    background: var(--bg-secondary);
    border: 1px solid var(--border-strong);
    border-radius: 4px;
    font-size: 0.75rem;
    font-weight: 600;
  }
  
  @media (max-width: 768px) {
    .filters-grid {
      grid-template-columns: 1fr;
    }
    
    .filter-actions {
      flex-direction: column;
      align-items: stretch;
    }
    
    .table-wrapper {
      font-size: 0.75rem;
    }
    
    .visitors-table th,
    .visitors-table td {
      padding: 0.5rem;
    }
  }
</style>

<script>
  if (typeof window !== 'undefined') {
    const AUTH_KEY = 'visitors-table-auth';
    const API_BASE = import.meta.env.PUBLIC_ANALYTICS_API || 'https://analytics-api-one.vercel.app/api';
    const API_ENDPOINT = `${API_BASE}/stats`;

    let allVisitors = [];
    let filteredVisitors = [];
    let currentSort = { field: 'timestamp', direction: 'desc' };

    const loadVisitors = async () => {
      const loadingEl = document.getElementById('table-loading');
      const errorEl = document.getElementById('table-error');
      const contentEl = document.getElementById('table-content');

      try {
        const response = await fetch(`${API_ENDPOINT}?limit=100000`, {
          method: 'GET',
          headers: { 'Accept': 'application/json' },
          cache: 'no-cache',
        });

        if (!response.ok) {
          throw new Error(`API returned ${response.status}: ${response.statusText}`);
        }

        const data = await response.json();
        
        if (!data.recentVisitors || !Array.isArray(data.recentVisitors)) {
          throw new Error('Invalid data format: recentVisitors not found');
        }

        // Get all visitors, excluding localhost
        const localhostIps = ['127.0.0.1', '::1', 'localhost'];
        allVisitors = data.recentVisitors.filter(v => {
          const ip = (v.ip || '').toLowerCase().trim();
          return !localhostIps.includes(ip);
        });
        
        // Populate filter dropdowns with unique values
        populateFilterOptions(allVisitors);
        
        // Apply initial filters and render
        applyFilters();
        
        loadingEl.style.display = 'none';
        errorEl.style.display = 'none';
        contentEl.style.display = 'block';
        
      } catch (error) {
        console.error('Failed to load visitor data:', error);
        loadingEl.style.display = 'none';
        errorEl.style.display = 'block';
        contentEl.style.display = 'none';
      }
    };

    const populateFilterOptions = (visitors) => {
      const deviceTypes = new Set();
      const browsers = new Set();
      const oses = new Set();

      visitors.forEach(v => {
        if (v.deviceType) deviceTypes.add(v.deviceType);
        if (v.browser) browsers.add(v.browser);
        if (v.os) oses.add(v.os);
      });

      const deviceSelect = document.getElementById('filter-device');
      const browserSelect = document.getElementById('filter-browser');
      const osSelect = document.getElementById('filter-os');

      [...deviceTypes].sort().forEach(dt => {
        const option = document.createElement('option');
        option.value = dt;
        option.textContent = dt;
        deviceSelect.appendChild(option);
      });

      [...browsers].sort().forEach(b => {
        const option = document.createElement('option');
        option.value = b;
        option.textContent = b;
        browserSelect.appendChild(option);
      });

      [...oses].sort().forEach(o => {
        const option = document.createElement('option');
        option.value = o;
        option.textContent = o;
        osSelect.appendChild(option);
      });
    };

    const applyFilters = () => {
      const filters = {
        ip: document.getElementById('filter-ip').value.toLowerCase().trim(),
        path: document.getElementById('filter-path').value.toLowerCase().trim(),
        city: document.getElementById('filter-city').value.toLowerCase().trim(),
        country: document.getElementById('filter-country').value.toLowerCase().trim(),
        device: document.getElementById('filter-device').value,
        browser: document.getElementById('filter-browser').value,
        os: document.getElementById('filter-os').value,
        source: document.getElementById('filter-source').value.toLowerCase().trim(),
        dateFrom: document.getElementById('filter-date-from').value,
        dateTo: document.getElementById('filter-date-to').value,
      };

      let baseFiltered = allVisitors.filter(visitor => {
        if (filters.ip && !(visitor.ip || '').toLowerCase().includes(filters.ip)) return false;
        if (filters.path && !(visitor.path || '').toLowerCase().includes(filters.path)) return false;
        if (filters.city && !(visitor.city || '').toLowerCase().includes(filters.city)) return false;
        if (filters.country && !(visitor.countryCode || '').toLowerCase().includes(filters.country)) return false;
        if (filters.device && visitor.deviceType !== filters.device) return false;
        if (filters.browser && visitor.browser !== filters.browser) return false;
        if (filters.os && visitor.os !== filters.os) return false;
        if (filters.source && !(visitor.source || visitor.sourceType || '').toLowerCase().includes(filters.source)) return false;
        if (filters.dateFrom || filters.dateTo) {
          const ts = visitor.timestamp ? new Date(visitor.timestamp) : null;
          if (!ts || isNaN(ts.getTime())) return false;
          const visitorDate = ts.toISOString().slice(0, 10);
          if (filters.dateFrom && visitorDate < filters.dateFrom) return false;
          if (filters.dateTo && visitorDate > filters.dateTo) return false;
        }
        return true;
      });

      const uniqueOnly = document.getElementById('filter-unique-only')?.checked ?? false;
      if (uniqueOnly) {
        const byIp = new Map();
        baseFiltered.forEach(v => {
          const ip = v.ip || 'unknown';
          const existing = byIp.get(ip);
          if (!existing) {
            byIp.set(ip, { ...v, visits: 1 });
          } else {
            existing.visits += 1;
            const vTs = v.timestamp ? new Date(v.timestamp).getTime() : 0;
            const eTs = existing.timestamp ? new Date(existing.timestamp).getTime() : 0;
            if (vTs > eTs) {
              Object.assign(existing, v, { visits: existing.visits });
            }
          }
        });
        filteredVisitors = Array.from(byIp.values());
      } else {
        filteredVisitors = baseFiltered;
      }

      applySort();
      renderTable();
      updateFilterCount();
    };

    const applySort = () => {
      const { field, direction } = currentSort;
      filteredVisitors.sort((a, b) => {
        let aVal = a[field] || '';
        let bVal = b[field] || '';

        // Handle numeric sorting (visits, timestamp)
        if (field === 'visits') {
          aVal = a.visits ?? 0;
          bVal = b.visits ?? 0;
        } else if (field === 'timestamp') {
          aVal = aVal ? new Date(aVal).getTime() : 0;
          bVal = bVal ? new Date(bVal).getTime() : 0;
        } else {
          // String comparison for other fields
          aVal = String(aVal).toLowerCase();
          bVal = String(bVal).toLowerCase();
        }

        if (direction === 'asc') {
          return aVal > bVal ? 1 : aVal < bVal ? -1 : 0;
        } else {
          return aVal < bVal ? 1 : aVal > bVal ? -1 : 0;
        }
      });
    };

    const renderTable = () => {
      const tbody = document.getElementById('visitors-tbody');
      if (!tbody) return;

      const uniqueOnly = document.getElementById('filter-unique-only')?.checked ?? false;
      const visitsCol = document.querySelector('.visits-col');
      if (visitsCol) visitsCol.style.display = uniqueOnly ? '' : 'none';

      if (filteredVisitors.length === 0) {
        tbody.innerHTML = `
          <tr>
            <td colspan="11" style="text-align: center; padding: 2rem; color: var(--text-muted);">
              No visitors match the current filters.
            </td>
          </tr>
        `;
        return;
      }

      tbody.innerHTML = filteredVisitors.map(visitor => {
        const timestamp = visitor.timestamp 
          ? new Date(visitor.timestamp).toLocaleString() 
          : '<span class="empty-cell">—</span>';
        
        const location = [visitor.city, visitor.regionCode, visitor.countryCode]
          .filter(Boolean)
          .join(', ') || '<span class="empty-cell">—</span>';

        const visitsCell = uniqueOnly ? `<td><span class="badge">${visitor.visits ?? 1}</span></td>` : '';
        return `
          <tr>
            ${visitsCell}
            <td>${timestamp}</td>
            <td><code>${visitor.ip || '<span class="empty-cell">—</span>'}</code></td>
            <td><code>${visitor.path || '/'}</code></td>
            <td>${visitor.city || '<span class="empty-cell">—</span>'}</td>
            <td>${visitor.regionCode || '<span class="empty-cell">—</span>'}</td>
            <td>${visitor.countryCode || '<span class="empty-cell">—</span>'}</td>
            <td>${visitor.deviceType ? `<span class="badge">${visitor.deviceType}</span>` : '<span class="empty-cell">—</span>'}</td>
            <td>${visitor.browser || '<span class="empty-cell">—</span>'}</td>
            <td>${visitor.os || '<span class="empty-cell">—</span>'}</td>
            <td>${visitor.source || visitor.sourceType || '<span class="empty-cell">—</span>'}</td>
          </tr>
        `;
      }).join('');

      updateSortIndicators();
    };

    const updateSortIndicators = () => {
      document.querySelectorAll('.visitors-table th[data-sort]').forEach(th => {
        th.removeAttribute('data-sort-direction');
        if (th.getAttribute('data-sort') === currentSort.field) {
          th.setAttribute('data-sort-direction', currentSort.direction);
        }
      });
    };

    const updateFilterCount = () => {
      const countEl = document.getElementById('filter-count-value');
      const totalEl = document.getElementById('filter-total-value');
      const labelEl = document.getElementById('filter-count-label');
      const uniqueOnly = document.getElementById('filter-unique-only')?.checked ?? false;
      if (countEl) countEl.textContent = filteredVisitors.length;
      if (totalEl) totalEl.textContent = allVisitors.length;
      if (labelEl) labelEl.textContent = uniqueOnly ? 'unique visitors' : 'visitors';
    };

    const clearFilters = () => {
      const uniqueOnly = document.getElementById('filter-unique-only');
      if (uniqueOnly) uniqueOnly.checked = false;
      document.getElementById('filter-ip').value = '';
      document.getElementById('filter-path').value = '';
      document.getElementById('filter-city').value = '';
      document.getElementById('filter-country').value = '';
      document.getElementById('filter-device').value = '';
      document.getElementById('filter-browser').value = '';
      document.getElementById('filter-os').value = '';
      document.getElementById('filter-source').value = '';
      document.getElementById('filter-date-from').value = '';
      document.getElementById('filter-date-to').value = '';
      applyFilters();
    };

    const sha256 = async (msg) => {
      const buf = await crypto.subtle.digest('SHA-256', new TextEncoder().encode(msg));
      return Array.from(new Uint8Array(buf)).map(b => b.toString(16).padStart(2, '0')).join('');
    };

    const setupTableListeners = () => {
      ['filter-ip', 'filter-path', 'filter-city', 'filter-country', 'filter-device', 'filter-browser', 'filter-os', 'filter-source', 'filter-date-from', 'filter-date-to', 'filter-unique-only'].forEach(id => {
        const el = document.getElementById(id);
        if (el) {
          if (el.tagName === 'INPUT') {
            el.addEventListener('input', applyFilters);
          } else {
            el.addEventListener('change', applyFilters);
          }
        }
      });
      const clearBtn = document.getElementById('clear-filters');
      if (clearBtn) clearBtn.addEventListener('click', clearFilters);
      document.querySelectorAll('.visitors-table th[data-sort]').forEach(th => {
        th.addEventListener('click', () => {
          const field = th.getAttribute('data-sort');
          if (currentSort.field === field) {
            currentSort.direction = currentSort.direction === 'asc' ? 'desc' : 'asc';
          } else {
            currentSort.field = field;
            currentSort.direction = 'asc';
          }
          applySort();
          renderTable();
        });
      });
    };

    const showTable = () => {
      document.getElementById('password-gate').style.display = 'none';
      document.getElementById('table-area').style.display = 'block';
      setupTableListeners();
      loadVisitors();
    };

    const checkAuth = (expectedHash) => {
      if (!expectedHash) return false;
      if (sessionStorage.getItem(AUTH_KEY) === expectedHash) {
        showTable();
        return true;
      }
      return false;
    };

    const initPasswordGate = () => {
      const container = document.querySelector('[data-expected-hash]');
      const expectedHash = container?.getAttribute('data-expected-hash') || '';
      if (!expectedHash) console.error('Password hash not found');

      if (checkAuth(expectedHash)) return;

      const form = document.getElementById('password-form');
      const input = document.getElementById('password-input');
      const errorEl = document.getElementById('password-error');
      if (!form || !input) return;

      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        const hash = await sha256(input.value);
        if (hash === expectedHash) {
          sessionStorage.setItem(AUTH_KEY, hash);
          errorEl.style.display = 'none';
          showTable();
        } else {
          errorEl.style.display = 'block';
          input.value = '';
          input.focus();
        }
      });
    };

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initPasswordGate);
    } else {
      initPasswordGate();
    }
  }
</script>
