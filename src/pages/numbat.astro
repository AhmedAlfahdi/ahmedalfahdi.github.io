---
import BaseLayout from '../layouts/BaseLayout.astro';
import NumbatRunner from '../components/NumbatRunner.astro';
---

<BaseLayout title="Numbat Calculator — Ahmed N. Alfahdi">
  <div style="max-width: 960px; margin: 0 auto; padding: 0.75rem 1rem 0;">
    <h1 style="font-size: 1.6rem; color: var(--accent-primary); margin-top: 0; margin-bottom: 0.4rem; text-align: center;">
      Numbat Calculator
    </h1>
    <p style="color: var(--text-secondary); font-size: 0.85rem; text-align: center; margin-bottom: 0;">
      High-precision scientific calculator with first-class physical units. Powered by <a href="https://github.com/sharkdp/numbat" target="_blank" style="color: var(--accent-secondary);">Numbat</a>.
    </p>
  </div>

  <div style="max-width: 960px; margin: 0 auto; padding: 0.75rem 1rem;">
    <style>
      .nb-tips-outer { display: flex; flex-wrap: wrap; gap: 0.4rem 1.2rem; justify-content: center; font-size: 0.78rem; }
      .nb-tip { color: var(--text-secondary); }
      .nb-tip code { font-family: var(--font-mono, 'Fira Mono', monospace); font-size: 0.76rem; background: var(--bg-tertiary, rgba(128,128,128,0.12)); color: var(--accent-secondary); padding: 0.08rem 0.4rem; border-radius: 3px; white-space: nowrap; }
      .nb-tip-label { color: var(--text-tertiary); font-weight: 600; }
    </style>
    <div class="nb-tips-outer">
      <span class="nb-tip"><span class="nb-tip-label">Commands:</span>
        <code>list</code>
        <code>list functions</code>
        <code>list variables</code>
        <code>list units</code>
        <code>list dimensions</code>
      </span>
      <span class="nb-tip"><span class="nb-tip-label">Info:</span>
        <code>info sum</code>
        <code>info c</code>
        <code>info meter</code>
        <code>info pi</code>
      </span>
      <span class="nb-tip"><span class="nb-tip-label">More:</span>
        <code>help</code>
        <code>clear</code>
      </span>
    </div>
  </div>

  <!-- PWA Install Banner — always visible, prompts native install when beforeinstallprompt fires -->
  <div id="nb-install-banner" class="nb-install-banner">
    <div class="nb-install-banner-inner">
      <span class="nb-install-icon">📥</span>
      <span class="nb-install-text" id="nb-install-text">
        <strong>Install for offline use</strong>
        <span class="nb-install-sub">Use Numbat anywhere, no internet needed</span>
      </span>
      <button id="nb-install-btn" class="nb-install-btn">Install</button>
      <button id="nb-install-dismiss" class="nb-install-dismiss" aria-label="Dismiss">✕</button>
    </div>
  </div>

  <NumbatRunner />

  <script>
    (() => {
      // ── PWA banner disabled for now ──
      const banner = document.getElementById('nb-install-banner');
      if (banner) { banner.style.display = 'none'; return; }
      const btn = document.getElementById('nb-install-btn');
      const dismiss = document.getElementById('nb-install-dismiss');
      const textEl = document.getElementById('nb-install-text');
      let installPrompt = null;

      // ── Visit frequency gate ──
      // Only show the install banner to frequent visitors (3+ visits).
      const VISIT_KEY = 'nb-visit-count';
      const VISIT_THRESHOLD = 3;
      let visitCount = parseInt(localStorage.getItem(VISIT_KEY) || '0', 10);
      visitCount += 1;
      localStorage.setItem(VISIT_KEY, String(visitCount));
      if (visitCount < VISIT_THRESHOLD) {
        banner.style.display = 'none';
        return;
      }

      // Already installed? Hide the banner.
      if (window.matchMedia('(display-mode: standalone)').matches) {
        banner.style.display = 'none';
        return;
      }

      // ── Browser detection ──
      const ua = navigator.userAgent;
      const isFirefox = /firefox/i.test(ua) && !/seamonkey/i.test(ua);
      const isChrome = /chrome|chromium|edg/i.test(ua) && !/firefox|opr|brave/i.test(ua) && !isFirefox;
      const isIOS = /iphone|ipad|ipod/.test(ua.toLowerCase());
      const isAndroid = /android/.test(ua.toLowerCase());
      const isSafari = /safari/i.test(ua) && !isChrome && !isFirefox && !isAndroid;

      // Firefox desktop: no PWA install support — hide banner entirely
      if (isFirefox && !isAndroid) {
        banner.style.display = 'none';
        return;
      }

      // Listen for the native prompt event (Chrome/Edge).
      window.addEventListener('beforeinstallprompt', (e) => {
        e.preventDefault();
        installPrompt = e;
      });

      // Click handler: use native prompt if available, otherwise show manual steps.
      btn.addEventListener('click', async () => {
        if (installPrompt) {
          installPrompt.prompt();
          const { outcome } = await installPrompt.userChoice;
          if (outcome === 'accepted') {
            banner.style.display = 'none';
          }
          installPrompt = null;
        } else {
          let hint = '';
          if (isIOS) {
            hint = 'Tap <strong>Share</strong> → <strong>Add to Home Screen</strong> in Safari';
          } else if (isAndroid && isFirefox) {
            hint = 'Tap <strong>⋮</strong> → <strong>Install</strong> (or <strong>Add to Home screen</strong>)';
          } else if (isAndroid && isChrome) {
            hint = 'Tap <strong>⋮</strong> → <strong>Install app</strong>';
          } else if (isChrome) {
            hint = 'Look for the install icon (⊕) in the address bar, or <strong>⋮</strong> → <strong>Cast, save & share</strong> → <strong>Install page as app…</strong>';
          } else if (isSafari) {
            hint = 'Safari desktop doesn&rsquo;t support PWA install. Try Chrome or Edge instead.';
          } else {
            hint = 'Use Chrome or Edge for one-click install and full offline support.';
          }
          textEl.innerHTML = `<strong>Manual install</strong><span class="nb-install-sub">${hint}</span>`;
          setTimeout(() => {
            textEl.innerHTML = '<strong>Install for offline use</strong><span class="nb-install-sub">Use Numbat anywhere, no internet needed</span>';
          }, 8000);
        }
      });

      dismiss.addEventListener('click', () => {
        banner.style.display = 'none';
      });
    })();
  </script>

  <style>
    .nb-install-banner {
      max-width: 960px;
      margin: 0.5rem auto 0;
      padding: 0 1rem;
    }
    .nb-install-banner-inner {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      padding: 0.6rem 0.8rem;
      border-radius: 8px;
      background: var(--bg-secondary, rgba(255,255,255,0.04));
      border: 1px solid var(--border-light, rgba(255,255,255,0.06));
      font-size: 0.82rem;
    }
    .nb-install-icon { font-size: 1.3rem; flex-shrink: 0; }
    .nb-install-text {
      display: flex;
      flex-direction: column;
      gap: 0.1rem;
      flex: 1;
      color: var(--text-secondary);
      transition: opacity 0.3s;
    }
    .nb-install-text strong { color: var(--text-primary); }
    .nb-install-sub { font-size: 0.72rem; opacity: 0.7; line-height: 1.4; }
    .nb-install-btn {
      padding: 0.35rem 0.9rem;
      border: none;
      border-radius: 5px;
      background: var(--accent-primary, #3498db);
      color: #fff;
      font-weight: 600;
      font-size: 0.8rem;
      cursor: pointer;
      white-space: nowrap;
      transition: background 0.2s;
      flex-shrink: 0;
    }
    .nb-install-btn:hover { background: var(--accent-secondary, #2ecc71); }
    .nb-install-dismiss {
      background: none;
      border: none;
      color: var(--text-tertiary);
      font-size: 0.9rem;
      cursor: pointer;
      padding: 0.2rem;
      opacity: 0.5;
      flex-shrink: 0;
    }
    .nb-install-dismiss:hover { opacity: 1; }
  </style>
</BaseLayout>