---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const projects = await getCollection('engineering');
  return projects.map(project => ({
    params: { slug: project.id.split('/').pop() || project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);
---

<BaseLayout title={project.data.title}>
  <div class="container">
    <a href="/engineering" class="back-link">← Back to Engineering</a>
    <article class="content">
      <div class="header">
        <div class="status-bar">
          <span class="status">STATUS: {project.data.status}</span>
          <span class="category">CATEGORY: {project.data.category}</span>
          <time>DATE: {project.data.date.toLocaleDateString()}</time>
        </div>
      </div>
      
      <div class="prose">
        <Content />
      </div>
    </article>
  </div>
</BaseLayout>

<style>
  .back-link {
    display: inline-block;
    margin-bottom: 2rem;
    color: var(--accent-secondary);
    text-decoration: none;
  }
  .header {
    margin-bottom: 3rem;
    border-bottom: 1px solid var(--border-light);
    padding-bottom: 2rem;
  }
  .status-bar {
    display: flex;
    gap: 2rem;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--accent-primary);
    margin-top: 1rem;
  }
  .prose {
    color: var(--text-secondary);
    line-height: 1.6;
    width: 100%;
    max-width: 1200px;
    margin: 0 auto;
    word-break: break-word;
    overflow-wrap: anywhere;
  }
  .prose :global(h2) {
    color: var(--text-primary);
    margin-top: 2.5rem;
    border-left: 3px solid var(--accent-secondary);
    padding-left: 1rem;
  }
  .prose :global(h3) {
    color: var(--text-primary);
    margin-top: 2rem;
  }
  .prose :global(table) {
    display: table;
    width: fit-content;
    max-width: 100%;
    table-layout: auto;
    border-collapse: collapse;
    margin: 1.5rem auto;
  }
  .prose :global(table th),
  .prose :global(table td) {
    padding: 0.4rem 0.6rem;
  }
  .prose :global(ul),
  .prose :global(ol) {
    padding-left: 1.5rem;
  }
  .prose :global(li) {
    margin: 0.35rem 0;
  }
  .prose :global(.pdf-viewer-wrapper) {
    margin-left: auto;
    margin-right: auto;
  }
  .prose :global(hr) {
    border: none;
    border-top: 1px solid var(--border-light);
    margin: 2.5rem 0;
  }
  .prose table td:first-child,
  .prose table th:first-child {
    width: 1%;
    white-space: nowrap;
  }
  .prose table td:nth-child(3),
  .prose table th:nth-child(3) {
    width: 1%;
    white-space: nowrap;
    text-align: center;
  }
</style>