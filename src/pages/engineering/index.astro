---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const projects = await getCollection('engineering');
// Sort by date descending
projects.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const inProgress = projects.filter(p => p.data.status === 'In Progress');
const completed = projects.filter(p => p.data.status !== 'In Progress');
const featured = completed.filter(p => p.data.featured);
const rest = completed.filter(p => !p.data.featured);
---

<BaseLayout title="Engineering Projects">
  <div class="container">
    <h1>Engineering Projects</h1>
    <p class="intro">In-depth mechanical and aerospace engineering analysis, design studies, and technical investigations.</p>

    <div class="grid">
      {featured.map(project => (
        <a href={`/engineering/${project.id}`} class="card">
          <div class="status-badge">{project.data.status}</div>
          <h2>{project.data.title}</h2>
          <p>{project.data.description}</p>
          <div class="meta">
            <span class="category">[{project.data.category}]</span>
            <time>{project.data.date.toLocaleDateString()}</time>
          </div>
        </a>
      ))}
      {rest.map(project => (
        <a href={`/engineering/${project.id}`} class="card">
          <div class="status-badge">{project.data.status}</div>
          <h2>{project.data.title}</h2>
          <p>{project.data.description}</p>
          <div class="meta">
            <span class="category">[{project.data.category}]</span>
            <time>{project.data.date.toLocaleDateString()}</time>
          </div>
        </a>
      ))}
    </div>

    {inProgress.length > 0 && (
    <div class="upcoming-section">
      <h2>In Progress</h2>
      <div class="grid">
        {inProgress.map(project => (
          <a href={`/engineering/${project.id}`} class="card">
            <div class="status-badge status-pending">{project.data.status}</div>
            <h2>{project.data.title}</h2>
            <p>{project.data.description}</p>
            <div class="meta">
              <span class="category">[{project.data.category}]</span>
              <time>{project.data.date.toLocaleDateString()}</time>
            </div>
          </a>
        ))}
      </div>
    </div>
    )}
    {inProgress.length === 0 && (
    <div class="upcoming-section">
      <h2>In Progress</h2>
      <div class="grid">
        <div class="card card-placeholder">
          <div class="status-badge status-pending">In Progress</div>
          <h2>Machine Design</h2>
          <p>Mechanical component design and analysis using parametric CAD and simulation tools.</p>
          <div class="meta">
            <span class="category">[Mechanical]</span>
          </div>
        </div>
        <div class="card card-placeholder">
          <div class="status-badge status-pending">In Progress</div>
          <h2>FEA Analysis</h2>
          <p>Finite element analysis case studies covering stress, thermal, and modal simulations.</p>
          <div class="meta">
            <span class="category">[Simulation]</span>
          </div>
        </div>
      </div>
    </div>
    )}
  </div>
</BaseLayout>

<style>
  .intro {
    color: var(--text-secondary);
    margin-bottom: 2rem;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 2rem;
  }
  .card {
    background: var(--bg-tertiary);
    border: 1px solid var(--border-light);
    padding: 1.5rem;
    text-decoration: none;
    color: inherit;
    transition: border-color 0.2s;
    position: relative;
  }
  a.card:hover {
    border-color: var(--accent-primary);
  }
  .card-placeholder {
    opacity: 0.45;
    cursor: default;
    pointer-events: none;
    user-select: none;
  }
  .status-badge {
    position: absolute;
    top: 1rem;
    right: 1rem;
    font-size: 0.68rem;
    padding: 0.2rem 0.6rem;
    background: var(--bg-primary);
    border: 1px solid var(--border-light);
    color: var(--accent-secondary);
    text-transform: uppercase;
    font-family: var(--font-mono);
  }
  .status-pending {
    color: var(--text-muted);
    border-color: var(--border-light);
  }
  .card h2 {
    margin: 0 0 0.5rem 0;
    color: var(--text-primary);
    padding-right: 7rem;
    font-size: 1.15rem;
  }
  .card p {
    color: var(--text-secondary);
    font-size: 0.9rem;
    margin-bottom: 1rem;
    line-height: 1.5;
  }
  .meta {
    display: flex;
    justify-content: space-between;
    font-size: 0.8rem;
    color: var(--text-muted);
    font-family: var(--font-mono);
  }
  .category {
    color: var(--accent-primary);
  }
  .upcoming-section {
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 1px solid var(--border-light);
  }
  .upcoming-section h2 {
    color: var(--text-muted);
    margin-bottom: 1.5rem;
    font-size: 1rem;
    text-transform: uppercase;
    letter-spacing: 1px;
  }
  .empty-state {
    text-align: center;
    padding: 3rem;
    color: var(--text-muted);
  }
</style>
