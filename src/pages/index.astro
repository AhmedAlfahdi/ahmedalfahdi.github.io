        <a href="https://linkedin.com/in/AhmedAlfahdi" target="_blank" class="contact-link">
          <span class="link-label">[LNK]</span> LinkedIn
        -->
        </a>
        <a href="mailto:Ahmed_N_Alfahdi@outlook.com" class="contact-link">
          <span class="link-label">[EM]</span>
          <span class="link-text">Ahmed_N_Alfahdi@outlook.com</span>
        </a>
        <!-- End of Selection -->

        </a>
      </div>
    </div>
  </div>
</BaseLayout>

<script is:inline>
  const homeUtc = document.getElementById('home-utc');
  const pad = (n) => String(n).padStart(2, '0');
  const pad3 = (n) => String(n).padStart(3, '0');
  const updateUtc = () => {
    const d = new Date();
    const date = `${d.getUTCFullYear()}-${pad(d.getUTCMonth() + 1)}-${pad(d.getUTCDate())}`;
    const ms = pad3(d.getUTCMilliseconds());
    const hours = pad(d.getUTCHours());
    const minutes = pad(d.getUTCMinutes());
    const seconds = pad(d.getUTCSeconds());
    
    // Only update if the time has changed (to preserve animations)
    const timeString = `${hours}:${minutes}:${seconds}`;
    const lastTime = homeUtc.dataset.lastTime;
    const lastHour = lastTime ? lastTime.split(':')[0] : null;
    const lastMinute = lastTime ? lastTime.split(':')[1] : null;
    const hourChanged = lastHour !== null && lastHour !== hours;
    const minuteChanged = lastMinute !== null && lastMinute !== minutes;
    
    if (lastTime !== timeString) {
      const colon1 = document.createElement('span');
      colon1.className = 'utc-colon';
      colon1.textContent = ':';
      colon1.style.display = 'inline-block';
      colon1.style.animation = 'colon-blink 1s step-end infinite';
      colon1.style.color = 'rgba(245, 165, 36, 0.71)';
      colon1.style.fontWeight = '700';
      
      const colon2 = document.createElement('span');
      colon2.className = 'utc-colon';
      colon2.textContent = ':';
      colon2.style.display = 'inline-block';
      colon2.style.animation = 'colon-blink 1s step-end infinite';
      colon2.style.color = 'rgba(245, 165, 36, 0.71)';
      colon2.style.fontWeight = '700';
      
      // Create hours span with animation if hour changed
      const hoursSpan = document.createElement('span');
      hoursSpan.textContent = hours;
      if (hourChanged) {
        hoursSpan.className = 'time-change-pulse';
        hoursSpan.style.display = 'inline-block';
        hoursSpan.style.animation = 'time-change 0.6s ease-out';
      }
      
      // Create minutes span with animation if minute changed
      const minutesSpan = document.createElement('span');
      minutesSpan.textContent = minutes;
      if (minuteChanged) {
        minutesSpan.className = 'time-change-pulse';
        minutesSpan.style.display = 'inline-block';
        minutesSpan.style.animation = 'time-change 0.6s ease-out';
      }
      
      // Clear and rebuild
      homeUtc.innerHTML = '';
      homeUtc.appendChild(document.createTextNode(`UTC ${date}`));
      // Add space between date and clock
      const spaceSpan = document.createElement('span');
      spaceSpan.className = 'utc-space';
      spaceSpan.style.display = 'inline-block';
      spaceSpan.style.width = '1rem';
      homeUtc.appendChild(spaceSpan);
      homeUtc.appendChild(hoursSpan);
      homeUtc.appendChild(colon1);
      homeUtc.appendChild(minutesSpan);
      homeUtc.appendChild(colon2);
      homeUtc.appendChild(document.createTextNode(`${seconds}.${ms} `));
      const dutSpan = document.createElement('span');
      dutSpan.className = 'utc-dut';
      dutSpan.style.fontSize = '0.8em';
      dutSpan.style.opacity = '0.7';
      dutSpan.textContent = '(DUT1 ±0.9s)';
      homeUtc.appendChild(dutSpan);
      
      homeUtc.dataset.lastTime = timeString;
    } else {
      // Only update milliseconds
      const textNodes = Array.from(homeUtc.childNodes).filter(n => n.nodeType === Node.TEXT_NODE);
      if (textNodes.length > 0) {
        const lastTextNode = textNodes[textNodes.length - 1];
        if (lastTextNode.textContent.includes('.')) {
          lastTextNode.textContent = lastTextNode.textContent.replace(/\d{2}\.\d{3}/, `${seconds}.${ms} `);
        }
      }
    }
  };
  if (homeUtc) {
    updateUtc();
    // Update every 10ms for smooth millisecond display
    setInterval(updateUtc, 10);
    
    // Debug: Check if colon elements exist
    setTimeout(() => {
      const colons = homeUtc.querySelectorAll('.utc-colon');
      console.log('Colon elements found:', colons.length);
      if (colons.length > 0) {
        colons.forEach((colon, i) => {
          console.log(`Colon ${i}:`, colon, 'computed style:', window.getComputedStyle(colon).animation);
        });
      }
    }, 1000);
  }

  // Skills animation removed - items are visible by default

  // Force gear animation on mobile devices - use real element instead of pseudo-element
  function initMobileGear() {
    const isMobile = window.innerWidth <= 768;
    const h1Dot = document.querySelector('.h1-dot');
    
    if (!h1Dot) return;
    
    // Check if mobile gear element already exists
    let mobileGear = h1Dot.querySelector('.mobile-gear');
    
    if (isMobile) {
      // Force transparent color
      h1Dot.style.setProperty('color', 'transparent', 'important');
      
      // Create real gear element if it doesn't exist
      if (!mobileGear) {
        mobileGear = document.createElement('span');
        mobileGear.className = 'mobile-gear';
        mobileGear.textContent = '⚙';
        mobileGear.style.cssText = `
          position: absolute;
          left: 50%;
          top: calc(50% + 0.15em);
          transform: translate(-50%, calc(-50% + 0.15em));
          font-size: 0.85em;
          line-height: 1;
          color: var(--accent-primary);
          z-index: 10;
          pointer-events: none;
          display: inline-block;
          animation: gear-spin 1.5s linear infinite;
        `;
        h1Dot.appendChild(mobileGear);
      }
      
      // Ensure animation is running
      mobileGear.style.animation = 'gear-spin 1.5s linear infinite';
      mobileGear.style.display = 'inline-block';
      mobileGear.style.opacity = '1';
    } else {
      // Remove mobile gear element on desktop
      if (mobileGear) {
        mobileGear.remove();
      }
      h1Dot.style.removeProperty('color');
    }
  }
  
  // Run immediately and on resize
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initMobileGear);
  } else {
    initMobileGear();
  }
  window.addEventListener('resize', initMobileGear);
  
  // Also trigger on first touch to ensure animation starts on mobile
  document.addEventListener('touchstart', function() {
    initMobileGear();
  }, { once: true, passive: true });

  // Collapsible skills list
  document.querySelectorAll('.skills-list > li').forEach((parentItem) => {
    const nestedList = parentItem.querySelector('ul');
    if (!nestedList) return;

    const childCount = nestedList.querySelectorAll('li').length;
    
    // Create count indicator element
    const countIndicator = document.createElement('span');
    countIndicator.className = 'child-count';
    countIndicator.textContent = ` (${childCount})`;
    countIndicator.style.display = 'none';
    
    const strongElement = parentItem.querySelector('strong');
    if (strongElement) {
      strongElement.appendChild(countIndicator);
    }

    // Function to update count visibility
    const updateCountVisibility = () => {
      if (parentItem.classList.contains('collapsed')) {
        countIndicator.style.display = 'inline';
      } else {
        countIndicator.style.display = 'none';
      }
    };

    // Add click handler to parent item
    parentItem.style.cursor = 'pointer';
    parentItem.addEventListener('click', (e) => {
      // Don't toggle if clicking directly on a nested list item or a link
      if (e.target !== parentItem && e.target !== parentItem.querySelector('strong') && e.target.closest('ul') === nestedList) {
        return;
      }
      // Don't toggle if clicking on a link
      if (e.target.tagName === 'A' || e.target.closest('a')) {
        return;
      }
      
      // Toggle collapsed/expanded state
      if (parentItem.classList.contains('collapsed')) {
        parentItem.classList.remove('collapsed');
        parentItem.classList.add('expanded');
      } else {
        parentItem.classList.remove('expanded');
        parentItem.classList.add('collapsed');
      }
      
      updateCountVisibility();
    });

    // Initialize as collapsed
    parentItem.classList.add('collapsed');
    updateCountVisibility();
  });

  // Collapse all functionality
  const collapseAllBtn = document.getElementById('collapse-all');
  if (collapseAllBtn) {
    collapseAllBtn.addEventListener('click', () => {
      document.querySelectorAll('.skills-list > li').forEach((item) => {
        const nestedList = item.querySelector('ul');
        if (!nestedList) return;
        item.classList.remove('expanded');
        item.classList.add('collapsed');
        const countIndicator = item.querySelector('.child-count');
        if (countIndicator) {
          countIndicator.style.display = 'inline';
        }
      });
    });
  }

  // Expand all functionality
  const expandAllBtn = document.getElementById('expand-all');
  if (expandAllBtn) {
    expandAllBtn.addEventListener('click', () => {
      document.querySelectorAll('.skills-list > li').forEach((item) => {
        const nestedList = item.querySelector('ul');
        if (!nestedList) return;
        item.classList.remove('collapsed');
        item.classList.add('expanded');
        const countIndicator = item.querySelector('.child-count');
        if (countIndicator) {
          countIndicator.style.display = 'none';
        }
      });
    });
  }
</script>

<style>
  .home-wrap {
    position: relative;
  }

  .home-wrap h1 {
    margin-top: 1.5rem;
    text-align: center;
    animation: h1-fade-in 0.8s ease-out;
    opacity: 0;
    animation-fill-mode: forwards;
    word-spacing: -0.2em;
    letter-spacing: -0.02em;
  }

  .h1-n-wrapper {
    position: relative;
    display: inline-block;
  }

  .h1-dot {
    display: inline-block;
    position: relative;
    transition: color 0.3s ease;
  }

  .h1-dot::after {
    content: '⚙';
    display: inline-block;
    position: absolute;
    left: 50%;
    top: calc(50% + 0.15em);
    transform: translate(-50%, -50%);
    font-size: 0.85em;
    line-height: 1;
    opacity: 0;
    transition: opacity 0.3s ease;
    pointer-events: none;
    color: var(--accent-primary);
    z-index: 10;
  }

  .home-wrap h1:hover .h1-dot {
    color: transparent;
  }

  .home-wrap h1:hover .h1-dot::after {
    opacity: 1 !important;
    animation: gear-spin 1.5s linear infinite;
  }

  .home-wrap h1:not(:hover) .h1-dot::after {
    opacity: 0;
    animation: none;
  }

  @keyframes gear-spin {
    0% {
      transform: translate(-50%, calc(-50% + 0.15em)) rotate(0deg);
    }
    100% {
      transform: translate(-50%, calc(-50% + 0.15em)) rotate(360deg);
    }
  }


  @keyframes h1-fade-in {
    from {
      opacity: 0;
      transform: translateY(15px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* Make container's dashed border wrap around UTC badge */
  .home-wrap.container {
    position: relative;
    overflow: visible;
    padding-top: 2.5rem;
  }

  /* Hide top border where badge sits (desktop only) */
  .home-wrap.container::before {
    border-top: none;
    top: 12px;
    height: calc(100% - 24px);
  }

  /* Restore top border on mobile */
  @media (max-width: 768px) {
    .home-wrap.container::before {
      border-top: 1px dashed var(--accent-primary) !important;
      top: 12px !important;
      height: calc(100% - 24px) !important;
    }
  }

  /* Add top border segments on left and right of badge */
  .utc-badge-border-left,
  .utc-badge-border-right {
    position: absolute;
    top: 12px;
    height: 1px;
    opacity: 0.45;
    pointer-events: none;
    z-index: 0;
    border-top: 1px dashed var(--accent-primary);
  }

  .utc-badge-border-left {
    left: 12px;
    width: calc(50% - 142px);
  }

  .utc-badge-border-right {
    right: 12px;
    width: calc(50% - 142px);
  }
  .utc-badge {
    display: flex;
    justify-content: center;
    align-items: center;
    flex-wrap: wrap;
    text-align: center;
    position: absolute;
    top: -4px;
    left: 50%;
    transform: translateX(-50%);
    margin: 0;
    width: fit-content;
    height: fit-content;
    min-height: 0;
    font-size: 1rem;
    letter-spacing: 1.2px;
    color: rgba(245, 165, 36, 0.71);
    text-decoration: none;
    padding: 10px 1.2rem;
    border: 1px solid var(--border-strong);
    border-radius: 8px;
    background: linear-gradient(135deg, rgba(26, 33, 42, 0.92), rgba(16, 24, 32, 0.92));
    backdrop-filter: blur(11.35px);
    -webkit-background-clip: unset;
    background-clip: unset;
    font-family: var(--font-mono);
    font-weight: 600;
    box-shadow: 
      inset 0 1px 0 rgba(255, 255, 255, 0.04),
      0 4px 12px rgba(0, 0, 0, 0.25);
    vertical-align: bottom;
    animation: utc-pulse-subtle 4s ease-in-out infinite;
    z-index: 10;
    overflow: visible;
    transition: all 0.3s ease;
  }

  @media (max-width: 768px) {
    .utc-badge {
      position: relative !important;
      top: 0 !important;
      left: auto !important;
      transform: none !important;
      width: 100% !important;
      max-width: 100% !important;
      margin: 0 auto 1rem !important;
      font-size: 0.7rem !important;
      padding: 8px 1rem !important;
      letter-spacing: 0.5px !important;
      line-height: 1.4 !important;
      border-radius: 6px !important;
      display: block !important;
      text-align: center !important;
      border-top: 1px dashed var(--accent-primary) !important;
      border-bottom: 1px dashed var(--accent-primary) !important;
      border-left: 1px dashed var(--accent-primary) !important;
      border-right: 1px dashed var(--accent-primary) !important;
    }

    .utc-badge::before,
    .utc-badge::after {
      display: none !important;
    }

    .utc-badge .utc-space {
      width: 0.5rem !important;
    }

    .home-wrap.container {
      padding-top: 1.5rem !important;
      overflow: visible !important;
    }
  }

  @media (max-width: 480px) {
    .utc-badge {
      font-size: 0.65rem !important;
      padding: 6px 0.8rem !important;
      letter-spacing: 0.3px !important;
    }

    .utc-badge .utc-space {
      width: 0.3rem !important;
    }

    .utc-badge .utc-dut {
      display: none !important;
    }

    /* Simplify time display on very small screens */
    .utc-badge {
      white-space: nowrap !important;
      overflow: hidden !important;
      text-overflow: ellipsis !important;
    }
  }

  .utc-badge:hover {
    text-shadow: 
      0 0 8px rgba(245, 165, 36, 0.8),
      0 0 16px rgba(245, 165, 36, 0.6),
      0 0 24px rgba(245, 165, 36, 0.4);
    color: rgba(245, 165, 36, 1);
  }

  .utc-badge:hover * {
    text-shadow: 
      0 0 8px rgba(245, 165, 36, 0.8),
      0 0 16px rgba(245, 165, 36, 0.6),
      0 0 24px rgba(245, 165, 36, 0.4);
    color: rgba(245, 165, 36, 1);
  }

  /* Outer dashed border - wraps around like wristband */
  .utc-badge::before {
    content: "";
    position: absolute;
    inset: -2px;
    border: 1px dashed var(--accent-primary);
    border-radius: 10px;
    opacity: 0.45;
    pointer-events: none;
    overflow: visible;
  }

  /* Inner dashed border - wraps around like wristband */
  .utc-badge::after {
    content: "";
    position: absolute;
    inset: -4px;
    border: 1px dashed var(--accent-primary);
    border-radius: 12px;
    opacity: 0.45;
    pointer-events: none;
    overflow: visible;
  }

  @keyframes utc-pulse-subtle {
    0%, 100% {
      box-shadow: 
        inset 0 1px 0 rgba(255, 255, 255, 0.04),
        0 4px 12px rgba(0, 0, 0, 0.25);
    }
    50% {
      box-shadow: 
        inset 0 1px 0 rgba(255, 255, 255, 0.04),
        0 4px 16px rgba(0, 0, 0, 0.3);
    }
  }

  /* Colon separators - Casio watch style blink (no fade) */
  .utc-colon {
    display: inline-block;
    animation: colon-blink 1s step-end infinite;
    color: rgba(245, 165, 36, 0.71);
    font-weight: 700;
    vertical-align: middle;
  }

  @keyframes colon-blink {
    0%, 49% {
      opacity: 1;
      visibility: visible;
    }
    50%, 100% {
      opacity: 0;
      visibility: hidden;
    }
  }

  /* Animation for hour/minute change */
  .time-change-pulse {
    display: inline-block !important;
    animation: time-change 0.6s ease-out !important;
  }

  @keyframes time-change {
    0% {
      transform: scale(1);
      color: rgba(245, 165, 36, 0.71);
    }
    50% {
      transform: scale(1.2);
      color: rgba(245, 165, 36, 1);
      text-shadow: 0 0 12px rgba(245, 165, 36, 0.8);
    }
    100% {
      transform: scale(1);
      color: rgba(245, 165, 36, 0.71);
    }
  }
  .subtitle {
    font-size: 1rem;
    color: var(--text-secondary);
    margin-bottom: 2rem;
    font-weight: 400;
    letter-spacing: 1px;
    font-family: var(--font-mono);
    border-left: 2px solid var(--accent-primary);
    padding-left: 1rem;
    position: relative;
    overflow: hidden;
    text-align: center;
    border-left: none;
    padding-left: 0;
    border-top: 2px solid var(--accent-primary);
    border-bottom: 2px solid var(--accent-primary);
    padding-top: 0.75rem;
    padding-bottom: 0.75rem;
  }

  .subtitle::before {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    height: 2px;
    background: linear-gradient(90deg, transparent, var(--accent-primary), transparent);
    opacity: 0.6;
    animation: border-glow-top 3s ease-in-out infinite;
  }

  .subtitle::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 2px;
    background: linear-gradient(90deg, transparent, var(--accent-primary), transparent);
    opacity: 0.6;
    animation: border-glow-bottom 3s ease-in-out infinite;
